            "name": "Decode a VIN into a full vehicle specification.",
            "description": {
              "content": "Decodes a 17-character VIN and returns the full vehicle specification (make, model, model year, body, engine, fuel, transmission and additional decoded attributes). The control sum is computed from `{VIN}|decode|{apikey}|{secretkey}`.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                ":apikey",
                ":controlsum",
                "decode",
                "{{vin}}.json"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "apikey",
                  "description": "(Required) The account API key (id)."
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "controlsum",
                  "description": "(Required) First 10 characters of `sha1(\"{lookup}|{id}|{apikey}|{secretkey}\")`."
                }
              ]
